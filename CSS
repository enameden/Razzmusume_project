.stat {
  margin:10px 0;
}

.stat label {
  display:block;
  margin-bottom:3px;
}

.stat input {
  width:80px;
  margin-bottom:5px;
}

.bar {
  width:100%;
  height:12px;
  background:#333;
  border-radius:6px;
}

.fill {
  height:100%;
  background:linear-gradient(90deg,#4caf50,#8bc34a);
  border-radius:6px;
  transition:width 0.2s;
}
